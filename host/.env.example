# ---- service ----
HOST_BIND=0.0.0.0
PORT=8443
ADMIN_PORT=8080
ADMIN_TOKEN=change-me
DATA_DIR=var

# ---- session ----
SESSION_MAX_MS=120000
SILENCE_MS=6500
SILENCE_BYE_MS=15000

# ---- soft timeouts ----
ASR_TIMEOUT_MS=600
LLM_TIMEOUT_MS=900
TTS_TIMEOUT_MS=800

# ---- judge ----
MAX_SHARE=0.40
RECENT3_PENALTY=0.85

# ---- providers: mock | aws ----
ASR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# ---- AWS (needed only when a provider above is "aws") ----
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-haiku
POLLY_VOICE_ID=Zhiyu

# ---- NVIDIA (optional, offline second judge) ----
NEMOTRON_ENABLED=0
