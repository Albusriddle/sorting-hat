# ---- service ----
HOST_BIND=0.0.0.0
PORT=8443
ADMIN_PORT=8080
ADMIN_TOKEN=change-me
# 必须与固件 secrets.h 里的 TOKEN 一致
DEVICE_TOKEN=change-me
DATA_DIR=var
# / 与 /stats 的免 token 来源
ADMIN_ALLOW_HOSTS=127.0.0.1,::1,172.17.0.1
METRICS_MAX_MB=5

# ---- TLS（可选；REQUIRE_TLS=1 时必须给证书，否则拒绝启动）----
REQUIRE_TLS=0
TLS_CERT=
TLS_KEY=

# ---- session ----
SESSION_MAX_MS=120000
# 必须大于最长台词（实测 6–7 s）
SILENCE_MS=12000
# 必须 >= SILENCE_MS + 5000，否则启动拒绝
SILENCE_BYE_MS=20000
BUDGET_MS=1240
TEXT_MAX_CHARS=200
TTS_BRIDGE_MAX_CHARS=40
MIN_AUDIO_RMS=50

# ---- soft timeouts ----
ASR_TIMEOUT_MS=600
LLM_TIMEOUT_MS=900
TTS_TIMEOUT_MS=800

# ---- judge ----
HISTORY_WINDOW=10
MIN_HISTORY_FOR_BALANCE=10
MAX_SHARE=0.40
RECENT3_PENALTY=0.85

# ---- providers: mock | aws ----
ASR_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
PRERECORD_REQUIRED=0

# ---- AWS ----
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-haiku
POLLY_VOICE_ID=Zhiyu

# ---- NVIDIA（可选，离线第二判官）----
NEMOTRON_ENABLED=0
